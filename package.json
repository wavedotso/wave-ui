{
  "name": "@waveso/ui",
  "version": "0.15.1",
  "description": "Wave UI component library built on Base UI and Tailwind CSS",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "keywords": [
    "react",
    "react-19",
    "ui",
    "components",
    "component-library",
    "design-system",
    "base-ui",
    "tailwindcss",
    "cva",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wavedotso/wave-ui.git"
  },
  "homepage": "https://github.com/wavedotso/wave-ui#readme",
  "bugs": "https://github.com/wavedotso/wave-ui/issues",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css",
    "./lib/*": null,
    "./hooks/*": null,
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write '**/*.ts' '**/*.tsx'",
    "format:check": "oxfmt --check '**/*.ts' '**/*.tsx'",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check:package": "publint && attw --pack . --ignore-rules no-resolution",
    "clean": "rm -rf dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "prepublishOnly": "pnpm build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "input-otp": "^1.4.0",
    "motion": "^12.0.0 || ^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "input-otp": {
      "optional": true
    },
    "motion": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@base-ui/react": "^1.8.0",
    "@changesets/cli": "^3.0.3",
    "@storybook/addon-a11y": "~10.6.0",
    "@storybook/addon-docs": "~10.6.0",
    "@storybook/react-vite": "~10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chromatic": "^18.9.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "jsdom": "^30.1.1",
    "motion": "^13.4.4",
    "oxfmt": "0.71.0",
    "oxlint": "^1.86.0",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "storybook": "~10.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
